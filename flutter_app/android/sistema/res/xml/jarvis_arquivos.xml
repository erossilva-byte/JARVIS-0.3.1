<?xml version="1.0" encoding="utf-8"?>
<!-- Caminhos que o FileProvider do atualizador pode entregar ao instalador do
     Android. Só a pasta privada de atualizações: nada de armazenamento externo. -->
<paths>
    <files-path name="atualizacoes" path="updates/" />
    <!-- Exportação de contatos em .vcf: pasta do app visível para o
         compartilhamento do Android, sem permissão ampla de armazenamento. -->
    <external-files-path name="exportacoes" path="exports/" />
</paths>
